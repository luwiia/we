#include <opencv2/opencv.hpp>
#include <iostream>
#include <algorithm>
#include <cmath>

int main() {
    // 1. Загрузка изображения
    cv::Mat img = cv::imread("test_image.jpg");
    if (img.empty()) {
        std::cout << "Ошибка: изображение не найдено!" << std::endl;
        return -1;
    }

    // Подготовка матриц
    cv::Mat gray_cv, hsv_cv;
    cv::Mat gray_custom(img.rows, img.cols, CV_8UC1);
    cv::Mat hsv_custom(img.rows, img.cols, CV_8UC3);

    // методы OpenCV
    cv::cvtColor(img, gray_cv, cv::COLOR_BGR2GRAY);
    cv::cvtColor(img, hsv_cv, cv::COLOR_BGR2HSV);

    // ===== ЗАДАЕМ ПРЯМУЮ ПО ДВУМ ТОЧКАМ =====
    cv::Point p1(86, 3);    // Начало прямой (x, y)
    cv::Point p2(222, 222); // Конец прямой (x, y)
    
    // Вычисляем параметры прямой: y = k*x + b
    float k = (float)(p2.y - p1.y) / (p2.x - p1.x); // Коэффициент наклона
    float b = p1.y - k * p1.x;                       // Смещение
    
    std::cout << "Параметры прямой: y = " << k << " * x + " << b << std::endl;
    // ========================================

    // 2. Попиксельный обход
    for (int y = 0; y < img.rows; y++) {
        for (int x = 0; x < img.cols; x++) {
            
            // Вычисляем значение Y на прямой для текущего X
            float line_y = k * x + b;
            
            // ЕСЛИ ПИКСЕЛЬ ВЫШЕ ПРЯМОЙ - ПРОПУСКАЕМ ОБРАБОТКУ
            if (y < line_y) {
                // Всё, что выше прямой - заливаем черным (пропуск обработки)
                gray_custom.at<uchar>(y, x) = 0;           // Черный в grayscale
                hsv_custom.at<cv::Vec3b>(y, x) = cv::Vec3b(0, 0, 0); // Черный в HSV
                continue; // Переходим к следующему пикселю
            }
            
            // НИЖЕ ПРЯМОЙ - ТВОЯ ОБЫЧНАЯ ОБРАБОТКА
            cv::Vec3b bgr = img.at<cv::Vec3b>(y, x);
            float b = bgr[0] / 255.0f;
            float g = bgr[1] / 255.0f;
            float r = bgr[2] / 255.0f;

            // Кастомный Grayscale
            uchar gray_val = cv::saturate_cast<uchar>(0.299f * bgr[2] + 0.587f * bgr[1] + 0.114f * bgr[0]);
            gray_custom.at<uchar>(y, x) = gray_val;

            // Кастомный HSV
            float max_v = std::max({r, g, b});
            float min_v = std::min({r, g, b});
            float diff = max_v - min_v;
            
            float h = 0, s = 0, v = max_v;

            if (max_v > 0) s = diff / max_v;

            if (diff != 0) {
                if (max_v == r) h = 60 * (fmod(((g - b) / diff), 6));
                else if (max_v == g) h = 60 * (((b - r) / diff) + 2);
                else if (max_v == b) h = 60 * (((r - g) / diff) + 4);
            }
            if (h < 0) h += 360;

            hsv_custom.at<cv::Vec3b>(y, x) = cv::Vec3b(
                cv::saturate_cast<uchar>(h / 2.0f), 
                cv::saturate_cast<uchar>(s * 255.0f), 
                cv::saturate_cast<uchar>(v * 255.0f)
            );
        }
    }

    // ===== ВИЗУАЛИЗАЦИЯ ПРЯМОЙ =====
    cv::Mat img_with_line = img.clone();
    // Рисуем красную линию по заданным точкам
    cv::line(img_with_line, p1, p2, cv::Scalar(0, 0, 255), 2);
    
    // Отмечаем сами точки (для наглядности)
    cv::circle(img_with_line, p1, 5, cv::Scalar(0, 255, 0), -1); // Зеленая точка - начало
    cv::circle(img_with_line, p2, 5, cv::Scalar(255, 0, 0), -1); // Синяя точка - конец
    
    // Добавляем подписи
    cv::putText(img_with_line, "Start (86,3)", 
                cv::Point(p1.x + 10, p1.y - 10), 
                cv::FONT_HERSHEY_SIMPLEX, 0.5, cv::Scalar(0, 255, 0), 1);
    cv::putText(img_with_line, "End (222,222)", 
                cv::Point(p2.x + 10, p2.y - 10), 
                cv::FONT_HERSHEY_SIMPLEX, 0.5, cv::Scalar(255, 0, 0), 1);
    // ================================

    // АНАЛИЗ
    cv::Mat diff_gray, diff_hsv;
    cv::absdiff(gray_cv, gray_custom, diff_gray);
    cv::absdiff(hsv_cv, hsv_custom, diff_hsv);

    cv::Scalar mean_gray = cv::mean(diff_gray);
    cv::Scalar mean_hsv = cv::mean(diff_hsv);

    std::cout << "=== РЕЗУЛЬТАТЫ СРАВНЕНИЯ ===" << std::endl;
    std::cout << "Средняя разница в Grayscale: " << mean_gray[0] << " единиц яркости" << std::endl;
    std::cout << "Средняя разница в HSV (H, S, V): " 
              << mean_hsv[0] << ", " << mean_hsv[1] << ", " << mean_hsv[2] << std::endl;
    
    // Вывод всех окон
    cv::imshow("Original with line (RED line)", img_with_line);
    cv::imshow("Gray OpenCV", gray_cv);
    cv::imshow("Gray Custom (BLACK = above line)", gray_custom);
    cv::imshow("HSV OpenCV", hsv_cv);
    cv::imshow("HSV Custom (BLACK = above line)", hsv_custom);
    
    // Показываем разницу
    cv::imshow("Difference Visualized (x20)", diff_hsv * 20);

    cv::waitKey(0);
    return 0;
}
