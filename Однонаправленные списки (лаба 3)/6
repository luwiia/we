#include <iostream>
using namespace std;

struct list{
    int info;
    list* next;
};

list* make()
{
    list* beg = new(list);
    list *p;
    int x;
    cin >> x;
    
    beg->info = x;
    beg->next = NULL;
    p = beg;
    
    while (x!=0){
        cin >> x;
        if (x!=0){
            list* r = new(list);
            r->info = x;
            r->next= NULL;
            p->next= r;
            p = r;
        }
    }
    return beg;
}

void print(list* beg)
{
    list* p = beg;
    while (p != NULL)
    {
        cout << "Elem:" << p->info << endl;
        p = p->next;
    }
}

int max(list* beg){
    list* p = beg;
    int max = p->info;
    
    while(p!=NULL){
        if (p->info > max) max = p->info;
        p = p->next;
    }
    return max;
}

void change(list* beg){
    list *p = beg;
    int max1 = max(beg);
    
    while (p!=NULL && p->next!=NULL){
        if ((9 < p->info < 100) && p->info>0 && p->next->info<0) p->info+=max1;
        p = p->next;
    }
}

int main(){
    list* beg = make();
    print(beg);
    change(beg);
    print(beg);
}

